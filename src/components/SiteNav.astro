---
import NavItem from "./NavItem.astro";

const links = [
    { href: "/projects", label: "Projects" },
    { href: "/writing", label: "Writing" },
    { href: "/extras", label: "Extras" },
    { href: "/uses", label: "Uses" },
];
---

<header class="w-full">
    <nav
        class="mx-auto flex h-14 w-full max-w-2xl items-center justify-between px-5"
    >
        <a
            href="/"
            class="font-medium text-ink no-underline hover:underline"
        >
            Mike McBride
        </a>
        <div class="flex items-center gap-1">
            <ul class="hidden items-center gap-1 text-sm md:flex">
                {links.map((l) => <NavItem href={l.href}>{l.label}</NavItem>)}
            </ul>
            <button
                type="button"
                data-theme-toggle
                aria-label="Toggle dark mode"
                class="inline-flex h-8 w-8 items-center justify-center rounded-sm text-muted transition hover:bg-chip hover:text-ink"
            >
                <svg
                    class="h-[18px] w-[18px] dark:hidden"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    aria-hidden="true"
                >
                    <circle cx="12" cy="12" r="4"></circle>
                    <path
                        d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
                    ></path>
                </svg>
                <svg
                    class="hidden h-[18px] w-[18px] dark:block"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    aria-hidden="true"
                >
                    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"
                    ></path>
                </svg>
            </button>
            <button
                type="button"
                id="menu-button"
                aria-label="Open menu"
                aria-controls="mobile-menu"
                aria-expanded="false"
                class="inline-flex h-8 w-8 items-center justify-center rounded-sm text-muted transition hover:bg-chip hover:text-ink md:hidden"
            >
                <svg
                    class="h-5 w-5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    aria-hidden="true"
                >
                    <path d="M4 7h16M4 12h16M4 17h16"></path>
                </svg>
            </button>
        </div>
    </nav>
    <div
        id="mobile-menu"
        hidden
        class="mx-auto max-w-2xl border-b border-line px-5 pb-4 md:hidden"
    >
        <ul class="-mx-3 flex flex-col">
            {links.map((l) => <NavItem href={l.href}>{l.label}</NavItem>)}
        </ul>
    </div>
</header>
<script is:inline>
    const prefersDarkQuery = window.matchMedia("(prefers-color-scheme: dark)");

    document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
        button.addEventListener("click", () => {
            const isDark = document.documentElement.classList.toggle("dark");
            // If the user toggles back to whatever the OS prefers, forget the
            // override so the site keeps following the OS from here on.
            if (isDark === prefersDarkQuery.matches) {
                localStorage.removeItem("theme");
            } else {
                localStorage.setItem("theme", isDark ? "dark" : "light");
            }
        });
    });

    // Track OS changes live unless the user has an explicit override.
    prefersDarkQuery.addEventListener("change", (e) => {
        if (!localStorage.getItem("theme")) {
            document.documentElement.classList.toggle("dark", e.matches);
        }
    });

    const menuButton = document.getElementById("menu-button");
    const mobileMenu = document.getElementById("mobile-menu");

    function setMenuOpen(open) {
        mobileMenu.hidden = !open;
        menuButton.setAttribute("aria-expanded", String(open));
        menuButton.setAttribute(
            "aria-label",
            open ? "Close menu" : "Open menu"
        );
    }

    menuButton.addEventListener("click", () => {
        setMenuOpen(mobileMenu.hidden);
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setMenuOpen(false));
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !mobileMenu.hidden) {
            setMenuOpen(false);
            menuButton.focus();
        }
    });
</script>
