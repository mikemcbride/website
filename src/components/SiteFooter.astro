---
const currentYear = new Date().getFullYear();

const links = [
    { href: "mailto:mike@mcbrides.us", label: "Email" },
    { href: "https://github.com/mikemcbride", label: "GitHub", external: true },
    { href: "https://www.linkedin.com/in/mcbride-mike/", label: "LinkedIn", external: true },
    { href: "/rss.xml", label: "RSS" },
];
---
<footer class="mx-auto mt-20 w-full max-w-2xl px-5">
    <div
        class="flex flex-wrap items-center justify-between gap-4 border-t border-line py-8 text-sm text-muted"
    >
        <span>&copy; {currentYear} Mike McBride</span>
        <ul class="flex items-center gap-5">
            {
                links.map((l) => (
                    <li>
                        <a
                            class="text-muted hover:text-ink"
                            href={l.href}
                            target={l.external ? "_blank" : undefined}
                            rel={l.external ? "noreferrer" : undefined}
                        >
                            {l.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</footer>
