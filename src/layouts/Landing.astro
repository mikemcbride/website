---
import DefaultLayout from "./Layout.astro";
import Prose from "../components/Prose.astro";
const { frontmatter } = Astro.props;
const title = frontmatter?.title || Astro.props.title;
const subheading = frontmatter?.subheading || Astro.props.subheading;
---

<DefaultLayout title={title}>
	<header class="mb-10">
		<Prose>
			<h1 class={subheading ? "mb-2" : ""}>{title}</h1>
			{
				subheading && (
					<p class="mt-0 text-zinc-600 dark:text-zinc-400">
						{subheading}
					</p>
				)
			}
		</Prose>
	</header>
	<slot />
</DefaultLayout>
