---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import site from "../data/site.json";
import { emojiFavicon } from "../utils/emojiFavicon";
const { title } = Astro.props;
const pageTitle = title || "Mike McBride";
// Change the emoji in src/data/site.json.
const faviconHref = emojiFavicon(site.favicon);
---

<!doctype html>
<html lang="en" class="h-full">
	<head>
		<script is:inline>
			// Runs before first paint so the correct theme is applied with no flash.
			// Follows the OS unless the user has explicitly toggled.
			const stored = localStorage.getItem("theme");
			const prefersDark = window.matchMedia(
				"(prefers-color-scheme: dark)",
			).matches;
			document.documentElement.classList.toggle(
				"dark",
				stored ? stored === "dark" : prefersDark,
			);
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href={faviconHref} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Mike McBride"
			href="/rss.xml"
		/>
		<link
			rel="preload"
			href="/fonts/jetbrains-mono-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta property="og:title" content={pageTitle} />
		<meta property="og:site_name" content="Mike McBride" />
		<meta property="og:type" content="website" />
		<meta name="twitter:title" content={pageTitle} />
	</head>
	<body
		class="min-h-full flex flex-col font-mono text-[15px] md:text-base leading-relaxed bg-surface text-body"
	>
		<SiteNav />
		<div class="mx-auto w-full max-w-2xl px-5 pt-10 md:pt-14 flex-grow">
			<slot />
		</div>
		<SiteFooter />
	</body>
</html>
