---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
const { title } = Astro.props;
const pageTitle = title || "Mike McBride";
---

<!doctype html>
<html lang="en" class="h-full">
	<head>
		<script is:inline>
			// Runs before first paint so the correct theme is applied with no flash.
			// Follows the OS unless the user has explicitly toggled.
			const stored = localStorage.getItem("theme");
			const prefersDark = window.matchMedia(
				"(prefers-color-scheme: dark)",
			).matches;
			document.documentElement.classList.toggle(
				"dark",
				stored ? stored === "dark" : prefersDark,
			);
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Mike McBride"
			href="/rss.xml"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link
			rel="preconnect"
			href="https://fonts.gstatic.com"
			crossorigin
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta property="og:title" content={pageTitle} />
		<meta property="og:site_name" content="Mike McBride" />
		<meta property="og:type" content="website" />
		<meta name="twitter:title" content={pageTitle} />
	</head>
	<body
		class="min-h-full flex flex-col font-sans text-base md:text-[17px] leading-relaxed bg-white text-zinc-900 dark:bg-zinc-950 dark:text-zinc-200"
	>
		<SiteNav />
		<div class="mx-auto w-full max-w-2xl px-5 pt-10 md:pt-14 flex-grow">
			<slot />
		</div>
		<SiteFooter />
	</body>
</html>
