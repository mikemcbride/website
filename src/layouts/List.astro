---
import DefaultLayout from "./Layout.astro";
import Prose from "../components/Prose.astro";
const { frontmatter } = Astro.props;
const title = frontmatter?.title || Astro.props.title;
const subtitle = frontmatter?.subtitle || Astro.props.subtitle;
---

<DefaultLayout title={title}>
	<main>
		<Prose>
			<h1 class={subtitle ? "mb-2" : ""}>{title}</h1>
			{
				subtitle && (
					<p class="mt-0 text-muted">
						{subtitle}
					</p>
				)
			}
			<slot />
		</Prose>
		<p class="mt-12 text-sm">
			<a
				href="/lists"
				class="text-muted hover:text-ink"
				>&larr; Lists</a
			>
		</p>
	</main>
</DefaultLayout>
