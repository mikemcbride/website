---
import DefaultLayout from "./Layout.astro";
import Prose from "../components/Prose.astro";
import { formatDate } from "../utils/formatDate";
const { frontmatter } = Astro.props;
const formattedDate = frontmatter.date
	? formatDate(frontmatter.date, "long")
	: null;
const backUrl = frontmatter.back_url || "/writing";
const backLabel =
	backUrl === "/writing"
		? "Writing"
		: backUrl === "/extras"
			? "Extras"
			: backUrl === "/lists"
				? "Lists"
				: "Back";
---

<DefaultLayout title={frontmatter.title}>
	<main>
		<Prose>
			<h1 class={formattedDate ? "mb-2" : ""}>{frontmatter.title}</h1>
			{
				formattedDate && (
					<p class="mt-0 text-sm text-zinc-500 dark:text-zinc-400">
						{formattedDate}
					</p>
				)
			}
			<slot />
		</Prose>
		<p class="mt-12 text-sm">
			<a
				href={backUrl}
				class="text-zinc-500 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
				>&larr; {backLabel}</a
			>
		</p>
	</main>
</DefaultLayout>
