---
import DefaultLayout from "./Layout.astro";
import Prose from "../components/Prose.astro";
const { frontmatter } = Astro.props;
let formattedDate = null;
if (frontmatter.date) {
	formattedDate = new Date(frontmatter.date).toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
}
---

<DefaultLayout title={frontmatter.title}>
	<main>
		<Prose>
			<h1>{frontmatter.title}</h1>
			{
				formattedDate && (
					<p class="-mt-8 font-mono text-sm tracking-widest uppercase text-zinc-500 dark:text-zinc-400">
						{formattedDate}
					</p>
				)
			}
			<slot />
			<div class="mt-12">
				<a
					href={frontmatter.back_url
						? frontmatter.back_url
						: "/writing"}>Go Back</a
				>
			</div>
		</Prose>
	</main>
</DefaultLayout>
