---
import LandingLayout from "../../layouts/Landing.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../../utils/formatDate";
let allBlogPosts = await getCollection("posts", ({ data }) => {
    return data.published === true;
});
allBlogPosts = allBlogPosts.sort((a, b) => {
    return new Date(b.data.date) > new Date(a.data.date) ? 1 : -1;
});
---

<LandingLayout
    title="Writing"
    subheading="Sometimes I write things. Not often enough to call it a blog."
>
    <section>
        <!-- Styled like a one-line code block (see `.prose pre`) so it reads
             as a terminal prompt. The label wrapper makes the whole block a
             click target. -->
        <label
            class="group mb-10 flex items-center gap-3 rounded-sm border border-line bg-chip px-4 py-3 text-base transition focus-within:border-muted md:text-sm"
        >
            <span
                aria-hidden="true"
                class="select-none text-muted transition group-focus-within:text-ink"
                >$</span
            >
            <input
                type="search"
                id="search-posts"
                placeholder="search posts…"
                aria-label="Search posts"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                class="w-full min-w-0 bg-transparent text-ink placeholder:text-muted focus:outline-none [caret-shape:block] [&::-webkit-search-cancel-button]:hidden [&::-webkit-search-decoration]:hidden"
            />
        </label>
        <ul class="flex flex-col gap-8">
            {
                allBlogPosts.map((post: any) => (
                    <li
                        data-search={`${post.data.title} ${post.data.excerpt ?? ""}`.toLowerCase()}
                    >
                        <article>
                            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                                <h2 class="font-medium leading-snug">
                                    <a href={`/writing/${post.id}`}>
                                        {post.data.title}
                                    </a>
                                </h2>
                                <time
                                    class="shrink-0 text-sm text-muted"
                                    datetime={post.data.date.toISOString()}
                                >
                                    {formatDate(post.data.date)}
                                </time>
                            </div>
                            {post.data.excerpt && (
                                <p class="mt-1 text-muted">
                                    {post.data.excerpt}
                                </p>
                            )}
                        </article>
                    </li>
                ))
            }
        </ul>
        <p id="no-results" hidden class="text-muted">
            No posts match that search.
        </p>
    </section>
</LandingLayout>

<script is:inline>
    const input = document.getElementById("search-posts");
    const items = document.querySelectorAll("[data-search]");
    const noResults = document.getElementById("no-results");

    input.addEventListener("input", (e) => {
        const q = e.target.value.trim().toLowerCase();
        let visible = 0;
        for (const item of items) {
            const match = !q || item.dataset.search.includes(q);
            item.hidden = !match;
            if (match) visible++;
        }
        noResults.hidden = visible > 0;
    });
</script>
