---
import LandingLayout from "../../layouts/Landing.astro";
import { getCollection } from "astro:content";
let allBlogPosts = await getCollection("posts", ({ data }) => {
    return data.published === true;
});
allBlogPosts = allBlogPosts.sort((a, b) => {
    return new Date(b.data.date) > new Date(a.data.date) ? 1 : -1;
});
---

<LandingLayout
    title="Writing"
    subheading="Sometimes I write things. Not often enough to call it a blog. You can read them here."
>
    <section>
        <fieldset
            class="w-full max-w-4xl relative mb-16 flex items-center text-zinc-400 dark:text-zinc-600 focus-within:text-accent!"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="absolute left-2 md:left-4 h-6 w-6 md:h-8 md:w-8"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <input
                type="text"
                id="search-posts"
                placeholder="Search posts..."
                class="rounded-lg
                border border-zinc-300 dark:border-zinc-500 focus:border-accent
                bg-surface
                shadow-sm shadow-zinc-900/5 dark:shadow-black/30
                text-lg md:text-xl font-sans
                pl-10 md:pl-16 pr-2 md:pr-4 py-4 md:py-6 w-full
                text-zinc-700 dark:text-zinc-200
                placeholder:text-zinc-500 dark:placeholder:text-zinc-400
                focus:outline-none focus:ring-1 focus:ring-accent
                focus-visible:ring-1 focus-visible:ring-accent"
            />
        </fieldset>
        <div
            class="mx-auto grid max-w-4xl grid-cols-1 gap-y-20 lg:max-w-none" 
        >
            <div class="flex flex-col gap-16">
                {
                    allBlogPosts.map((post: any) => (
                <article class="group relative flex flex-col items-start" data-title={post.data.title}>
                            <h2 class="font-mono text-2xl md:text-4xl font-extrabold tracking-tight text-zinc-800 transition group-hover:text-accent dark:text-zinc-100">
                                <a href={`/writing/${post.id}`}>
                                    <span class="absolute inset-0 z-20" />
                                    <span class="relative z-10">
                                        {post.data.title}
                                    </span>
                                </a>
                            </h2>
                            <time
                                class="relative z-10 order-first mb-1 flex items-center font-mono text-xs md:text-sm uppercase tracking-widest text-zinc-400 dark:text-zinc-500"
                                datetime={post.data.date}
                            >
                                {post.data.date.toDateString()}
                            </time>
                            <p class="relative z-10 mt-2 text-base text-zinc-600 dark:text-zinc-400">
                                {post.data.excerpt}
                            </p>
                            <div
                                aria-hidden="true"
                                class="relative z-10 mt-4 flex items-center font-mono text-xs md:text-sm font-medium uppercase tracking-widest text-accent"
                            >
                                Read article
                                <svg
                                    viewBox="0 0 16 16"
                                    fill="none"
                                    aria-hidden="true"
                                    class="ml-1 h-4 w-4 stroke-current transition-transform group-hover:translate-x-1"
                                >
                                    <path
                                        d="M6.75 5.75 9.25 8l-2.5 2.25"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>
</LandingLayout>

<script is:inline>
    const _searchInput = document.getElementById("search-posts");
    const _postNodes = document.querySelectorAll("article");

    _searchInput.addEventListener("input", (e) => {
        for (let node of _postNodes) {
            if (
                new RegExp(e.target.value, "gi").test(
                    node.attributes["data-title"].value
                )
            ) {
                node.classList.remove("hidden");
                node.classList.remove("md:hidden");
            } else {
                node.classList.add("hidden");
                node.classList.add("md:hidden");
            }
        }
    });
</script>
