---
import LandingLayout from "../layouts/Landing.astro";
import projects from "../data/projects.js";
---

<LandingLayout
    title="Projects"
    subheading="When I'm not making stuff for my day job, I like to build websites, apps, and utilities to help other developers. A few are listed here; the rest are on GitHub."
>
    <section>
        <ul class="flex flex-col gap-8">
            {
                projects.map((project: any) => (
                    <li>
                        <article>
                            <h2 class="text-lg font-semibold leading-snug tracking-tight text-zinc-900 dark:text-zinc-100">
                                {project.title}
                            </h2>
                            <p class="mt-1 text-zinc-600 dark:text-zinc-400">
                                {project.description}
                            </p>
                            <p class="mt-2 flex items-center gap-4 text-sm">
                                {project.links.map((link: any) => (
                                    <a
                                        href={link.url}
                                        rel="nofollow noreferrer"
                                        target="_blank"
                                        class="font-medium text-accent hover:underline"
                                    >
                                        {link.title}
                                    </a>
                                ))}
                            </p>
                        </article>
                    </li>
                ))
            }
        </ul>
    </section>
</LandingLayout>
