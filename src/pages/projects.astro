---
import LandingLayout from "../layouts/Landing.astro";
import projects from "../data/projects.js";
---

<LandingLayout
    title="Projects"
    subheading="When I'm not making stuff for my day job, I like to build websites, apps, and utilities to help other developers. You can find some of them listed below, and the rest you can find on my GitHub profile."
>
    <section>
        <div class="flex flex-col gap-16">
            {
                projects.map((project: any) => (
                    <article class="flex flex-col items-start">
                        <h2 class="font-mono text-2xl md:text-4xl font-extrabold tracking-tight text-zinc-800 dark:text-zinc-100">
                            {project.title}
                        </h2>
                        <p class="mt-2 text-base text-zinc-600 dark:text-zinc-400">
                            {project.description}
                        </p>
                        <div class="mt-4 flex items-center gap-6 font-mono text-xs md:text-sm font-medium uppercase tracking-widest">
                            {project.links.map((link: any) => (
                                <a
                                    href={link.url}
                                    rel="nofollow noreferrer"
                                    target="_blank"
                                    class="text-accent transition hover:underline"
                                >
                                    {link.title}
                                </a>
                            ))}
                        </div>
                    </article>
                ))
            }
        </div>
    </section>
</LandingLayout>
