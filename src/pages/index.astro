---
import Layout from "../layouts/Layout.astro";
import Prose from "../components/Prose.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../utils/formatDate";

const recentPosts = (
    await getCollection("posts", ({ data }) => data.published === true)
)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .slice(0, 5);
---

<Layout>
    <main>
        <Prose>
            <h1>Hi, I'm Mike.</h1>
            <p>
                I'm a senior software engineer at The New York Times, where I
                work on the core infrastructure behind <a
                    href="https://www.nytimes.com"
                    target="_blank"
                    rel="noreferrer">nytimes.com</a
                >. Before
                that I spent eleven years at World Wide Technology working
                on a little bit of everything. The common thread, it turns
                out, is that I like building platforms and tools for other
                engineers.
            </p>
            <p>
                I live in St. Louis with my wife and our four kids. I like
                reading, LSU football, Oxford commas, keyboard shortcuts,
                hammocks, the month of October, and pineapple on pizza. I
                don't like glitter, whales, or cottage cheese.
            </p>
        </Prose>

        <section class="mt-14">
            <h2
                class="mb-5 text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100"
            >
                Recent writing
            </h2>
            <ul class="flex flex-col gap-3">
                {
                    recentPosts.map((post) => (
                        <li class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                            <a
                                href={`/writing/${post.id}`}
                                class="font-medium text-zinc-900 transition hover:text-accent dark:text-zinc-100"
                            >
                                {post.data.title}
                            </a>
                            <time
                                class="shrink-0 text-sm text-zinc-500 dark:text-zinc-400"
                                datetime={post.data.date.toISOString()}
                            >
                                {formatDate(post.data.date)}
                            </time>
                        </li>
                    ))
                }
            </ul>
            <p class="mt-5 text-sm">
                <a
                    href="/writing"
                    class="font-medium text-accent hover:underline"
                    >All writing &rarr;</a
                >
            </p>
        </section>

        <section class="mt-14">
            <Prose>
                <p>
                    You can also see <a href="/projects"
                        >some tools I've built</a
                    > or poke around <a href="/extras">the extras</a>.
                </p>
            </Prose>
        </section>
    </main>
</Layout>
